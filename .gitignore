# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets. There are none this app needs — it makes no network calls and reads
# no credentials — but the file must never be committed if that ever changes.
.env
.env.*
!.env.example

# Virtualenv
.venv/
venv/

# Streamlit
.streamlit/secrets.toml

# Model cache. The catalogue embeddings ARE committed (see README) but the
# ONNX weights are downloaded at runtime and must not be committed — they are
# ~65MB and would bloat every clone of a repo whose whole point is the code.
model_cache/
.model_cache/
models/
.cache/

# Real footage. This demo has none, but if you point it at your own media it
# should never reach the repo.
*.mp4
*.mov
*.mkv